{
  "name": "atl-pragal",
  "version": "1.0.0",
  "description": "Site ATL – EB1/JI nº1 do Pragal",
  "scripts": {
    "build":   "tsc --noEmit && esbuild src/ts/main.ts --bundle --outfile=src/js/main.js --minify",
    "watch":   "esbuild src/ts/main.ts --bundle --outfile=src/js/main.js --sourcemap --watch",
    "dev":     "npm run watch & npx serve src",
    "lint":    "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "esbuild":    "^0.21.0",
    "serve":      "^14.2.0"
  }
}