{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ES2015",
    "lib": ["ES2015", "ES2017", "DOM"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "moduleResolution": "node",
    "sourceMap": true,
    "removeComments": false,

    // esbuild handles the output — tsc only does type checking
    "noEmit": true
  },
  "include": ["src/ts/**/*.ts"],
  "exclude": ["node_modules"]
}